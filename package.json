{
  "name": "@yehu77/dsh-kisekae",
  "version": "0.1.0",
  "description": "Anime-inspired Web themes and delightful UI extensions for DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "ASSETS_LICENSE.md",
    "assets/manifest.yaml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "clean": "rimraf lib",
    "typecheck": "tsc --noEmit",
    "bundle": "tsdown",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "pnpm run clean && pnpm run bundle && pnpm run build:types",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm run test",
    "dev": "tsdown --watch",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "anime",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehu77/dsh-kisekae.git"
  },
  "bugs": {
    "url": "https://github.com/yehu77/dsh-kisekae/issues"
  },
  "homepage": "https://github.com/yehu77/dsh-kisekae#readme",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "rimraf": "^6.1.2",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
